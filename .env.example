# Active transport implementation: "livekit" for production/real audio, "mock" or "demo" (dev only)
VITE_TRANSPORT=livekit

# Base URL for HTTP API requests (e.g. /api in dev via Vite proxy, or https://eventmic-server.onrender.com/api in production)
VITE_API_BASE=https://your-server-domain.onrender.com/api

# WebSocket URL for real-time state and signaling (must be explicit in production since Vercel does not proxy WebSockets)
VITE_SOCKET_URL=wss://your-server-domain.onrender.com/ws

# Optional build version override (defaults to git short hash or package version)
VITE_APP_VERSION=1.0.0
